#include <windows.h>
#include "resource.h"

IDI_FUWA ICON "Fuwa.ico"
1 RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,5,6
 PRODUCTVERSION 0,1,5,6
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "yuxino and Fuwa contributors\0"
            VALUE "FileDescription", "Fuwa window mirror\0"
            VALUE "FileVersion", "0.1.5.6\0"
            VALUE "InternalName", "Fuwa\0"
            VALUE "LegalCopyright", "Copyright (C) 2026 yuxino and Fuwa contributors\0"
            VALUE "OriginalFilename", "Fuwa.exe\0"
            VALUE "ProductName", "Fuwa\0"
            VALUE "ProductVersion", "0.1.5.6\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
